<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.maick.pivot-backtest</string>

    <!-- Woechentlich: rechnet den retrospektiven Walk-Forward (RETRO) neu - den
         Teil, den die Cloud-Pipeline bewusst NICHT rechnet - und laedt das
         Ergebnis nach R2 (_deploy/signal-hub/), sonst sieht Pages es nie und der
         Cloud-Spiegel ueberschreibt es lokal wieder (bis 2026-10-02 rief diese
         plist pivot_backtest.py direkt auf: RETRO-Stand blieb ab 09.08. stehen).
         osascript-Wrapper wie bei com.maick.signalhub.server (launchd-Python darf
         iCloud nicht direkt lesen). -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/osascript</string>
        <string>-e</string>
        <string>do shell script "'/Users/maickschwillo/Library/Mobile Documents/com~apple~CloudDocs/Trading-System/Maick Trading System/Signal-Hub/scripts/weekly_backtest_upload.sh' >> /tmp/pivot-backtest.log 2>&amp;1"</string>
    </array>

    <!-- Sonntags 08:15 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/maickschwillo</string>

    <key>StandardOutPath</key>
    <string>/tmp/pivot-backtest-launchagent.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/pivot-backtest-launchagent.log</string>
</dict>
</plist>
